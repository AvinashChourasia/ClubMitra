# Copy this file to `.env` and adjust as needed.
# `.env` is gitignored (it holds secrets); `.env.example` is committed as a template.

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# These credentials match docker-compose.yml. Host port is 5433 (see compose
# comment). sslmode=disable is fine for local Docker.
DATABASE_URL=postgres://clubmitra:clubmitra@localhost:5433/clubmitra?sslmode=disable

# --- Redis (challenge leaderboards) ---
# Host port 6380 (see compose comment). Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6380

# --- Auth ---
# ClubMitra is standalone: it owns identity and stores bcrypt password hashes, so
# register/login are handled in-app (no external identity provider).
# Generate strong values with:  openssl rand -base64 32
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# --- Server ---
# 8080 is a very common default (Tomcat, etc.); 8090 avoids local conflicts.
PORT=8090
ENV=development

# --- Strava activity sync — OPTIONAL ---
# DORMANT until these are set: the connect endpoint returns 503 and the mobile
# Settings card stays hidden, so the app ships safely without keys.
#   • Create an app at https://www.strava.com/settings/api (read-only).
#   • STRAVA_CLIENT_ID / STRAVA_CLIENT_SECRET come from that app's settings.
#   • In the Strava app settings, set "Authorization Callback Domain" to the API
#     host ONLY (no scheme/path), e.g. clubmitra-api.onrender.com — Strava
#     validates just the domain; our callback path is
#       https://<api-host>/api/v1/public/integrations/strava/callback
#   • We request scope activity:read_all (read-only; includes "Only You" runs).
#   • OAuth tokens are stored encrypted (AES-GCM, key derived from JWT_SECRET).
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# --- Payments (Razorpay) — OPTIONAL ---
# DORMANT until these are set: order/checkout endpoints return 503, so the app
# ships safely without keys. Use TEST keys (rzp_test_...) from the Razorpay
# dashboard to exercise the full flow before going live.
#   • RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET — API keys (dashboard → Settings → API Keys)
#   • RAZORPAY_WEBHOOK_SECRET — the secret set when creating the webhook; verifies
#     incoming webhooks. Point the webhook at:
#       https://<api-host>/api/v1/public/payments/razorpay/webhook
#     subscribed to payment.captured and payment.failed.
#   • PLATFORM_CUT_PCT — platform's recorded cut per payment (default 10).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PLATFORM_CUT_PCT=10
